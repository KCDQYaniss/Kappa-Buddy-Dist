{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kappa Buddy",
  "version": "1.0.0",
  "identifier": "dev.tarkovtracker.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kappa Buddy",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "title": "Kappa Buddy Overlay",
        "url": "overlay.html",
        "width": 324,
        "height": 170,
        "x": 16,
        "y": 16,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8765; script-src 'self' 'unsafe-eval' 'unsafe-inline'; img-src 'self' data: blob: https://assets.tarkov.dev; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://127.0.0.1:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "C:/Users/Sinqy/Documents/tarkov-tracker/assets/tarkov-server.exe": "tarkov-server.exe"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://kappa-buddy.itch.io/kappa-buddy/download/kappa-buddy/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzODZDRjUwQkJGMzk5MDEKUldRQm1mTzdVTStHazRXamFyOUt1Rk4rQVAybUNWVTNmQ283UUd1aFBZOVR2eTZaMTJWU3NmNjkK"
    }
  }
}
